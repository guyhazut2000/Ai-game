{
  "name": "ai-game",
  "version": "0.1.0",
  "private": true,
  "description": "Browser-based multiplayer RPG — learning project for AI, microservices, and game architecture",
  "workspaces": [
    "client",
    "services/*",
    "shared"
  ],
  "scripts": {
    "dev:client": "npm run dev -w client",
    "dev:gateway": "npm run dev -w gateway",
    "build:client": "npm run build -w client",
    "build:gateway": "npm run build -w gateway",
    "docker:infra": "docker compose up -d postgres redis",
    "docker:down": "docker compose down",
    "docker:app": "docker compose --profile app up --build"
  },
  "engines": {
    "node": ">=18"
  }
}
