# Copy to .env and adjust. Used by services and docker-compose overrides.

# Database (PostgreSQL)
DB_URL=postgresql://game:game@localhost:5432/ai_game

# Redis
REDIS_URL=redis://localhost:6379

# Gateway
PORT=3000

# Optional: message broker (uncomment when added)
# KAFKA_BROKERS=localhost:9092
# RABBITMQ_URL=amqp://localhost:5672
